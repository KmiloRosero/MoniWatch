# Copy this file to .env and replace every placeholder value.

NODE_ENV=development
PORT=3000

# SQLite path is relative to prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_USER_ACCESS_TTL_SECONDS=900
JWT_DEVICE_ACCESS_TTL_SECONDS=600
USER_REFRESH_TOKEN_TTL_DAYS=30
DEVICE_REFRESH_TOKEN_TTL_DAYS=30

# Watch pairing (code shown on the watch, typed on the phone)
DEVICE_PAIRING_CODE_TTL_SECONDS=300
DEVICE_PAIRING_CODE_LENGTH=8
DEVICE_PAIRING_POLL_INTERVAL_SECONDS=3

# Password / PIN hashing cost
BCRYPT_SALT_ROUNDS=12

# Provider token encryption (AES-256-GCM). Must decode to exactly 32 bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=replace-with-base64-32-byte-key
TOKEN_ENCRYPTION_KEY_ID=key-v1
TOKEN_FINGERPRINT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Payment PIN protection (watch payments)
PAYMENT_PIN_MAX_ATTEMPTS=5
PAYMENT_PIN_LOCK_MINUTES=15

# Transactions
TRANSACTION_EXPIRATION_MINUTES=15
# How often stuck PENDING/PROCESSING transactions are expired
TRANSACTION_SWEEP_INTERVAL_SECONDS=60

# Payment providers: each one runs against the simulator or its real API.
# Nequi only supports SIMULATED for now.
NEQUI_MODE=SIMULATED
# Switch to LIVE once the four WOMPI_* keys below are filled in.
WOMPI_MODE=SIMULATED
PAYMENT_SIMULATOR_APPROVAL_RATE=0.8
PAYMENT_SIMULATOR_LATENCY_MS=400

# Wompi (https://comercios.wompi.co > Desarrolladores). Sandbox: https://sandbox.wompi.co/v1
WOMPI_API_URL=https://sandbox.wompi.co/v1
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
# How long a payment waits for Wompi's final answer (attempts x interval) before returning "processing".
WOMPI_STATUS_POLL_ATTEMPTS=6
WOMPI_STATUS_POLL_INTERVAL_MS=1000

# Wompi events (webhooks): secret from the Wompi dashboard. Leave empty to disable.
WOMPI_EVENTS_SECRET=

# Rate limiting per IP: THROTTLE_LIMIT requests per THROTTLE_TTL_SECONDS window,
# THROTTLE_SENSITIVE_LIMIT for login, refresh, PIN and pairing endpoints.
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
THROTTLE_SENSITIVE_LIMIT=10
