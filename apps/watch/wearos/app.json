{
  "expo": {
    "name": "MoniWatch",
    "slug": "moniwatch-wear",
    "scheme": "moniwatchwear",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "android": {
      "package": "com.moniwatch.wear",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive.png",
        "backgroundColor": "#000000"
      }
    },
    "plugins": [
      "expo-status-bar",
      "expo-secure-store",
      "expo-dev-client",
      "./plugins/with-wear-os",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 96,
          "backgroundColor": "#000000"
        }
      ]
    ],
    "icon": "./assets/icon.png"
  }
}
