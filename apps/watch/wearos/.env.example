# Copy to .env. Expo inlines EXPO_PUBLIC_* variables at build time: never put secrets here.

# Backend base URL (include /api/v1).
# Wear OS emulator: http://10.0.2.2:3000/api/v1
# Physical watch on the same Wi-Fi: http://<your-computer-LAN-IP>:3000/api/v1
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api/v1

# Money formatting and conversion to the backend's amountInCents.
EXPO_PUBLIC_LOCALE=es-CO
EXPO_PUBLIC_CURRENCY=COP
EXPO_PUBLIC_CURRENCY_MINOR_UNITS_PER_MAJOR=100

# Quick amount buttons on the amount screen (major units, comma-separated).
EXPO_PUBLIC_QUICK_AMOUNTS=10000,20000,50000

# Hard cap for the keypad (major units). Device limits from the backend still apply on top.
EXPO_PUBLIC_MAX_KEYPAD_AMOUNT=2000000
