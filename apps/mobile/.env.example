# Copy to .env. Expo inlines EXPO_PUBLIC_* variables at build time:
# never put private secrets here.

# Backend base URL (include /api/v1).
# Android emulator: http://10.0.2.2:3000/api/v1
# Physical device: http://<your-computer-LAN-IP>:3000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Country calling code used to convert local phone numbers to E.164.
EXPO_PUBLIC_DEFAULT_COUNTRY_CODE=57

# Money formatting and conversion to the backend's amountInCents.
EXPO_PUBLIC_LOCALE=es-CO
EXPO_PUBLIC_CURRENCY=COP
EXPO_PUBLIC_CURRENCY_MINOR_UNITS_PER_MAJOR=100

# Wompi keys and mode are served by the backend (GET /payment-methods/providers/wompi).
